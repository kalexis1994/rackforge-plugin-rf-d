+/// Experimental minimum-degree ordering computed once outside processing.
+/// The initial Jacobian's symmetric graph includes C10 even if it is open.
+/// All coefficients of every future Jacobian are still evaluated and solved.
+pub fn initial_state_ordered(
+    p: Parameters,
+    conversion: ConversionParameters,
+    headphone: HeadphoneParameters,
+    b: Boundary,
+    ladder_seed: [f64; 16],
+) -> Result<State, StepError> {
+    let mut state = initial_state(p, conversion, headphone, b, ladder_seed)?;
+    let (_, j) = linearize(&state, p, conversion, headphone, b, &state.node_v)?;
+    let mut graph = std::array::from_fn::<_, N, _>(|i| {
+        std::array::from_fn::<_, N, _>(|k| i != k && (j[i][k] != 0.0 || j[k][i] != 0.0))
+    });
+    graph[7][22] = true;
+    graph[22][7] = true;
+    let mut removed = [false; N];
+    let mut order = [0; N];
+    for selected in &mut order {
+        let mut best_node = 0;
+        let mut best_degree = N + 1;
+        for i in 0..N {
+            if removed[i] {
+                continue;
+            }
+            let degree = (0..N).filter(|k| !removed[*k] && graph[i][*k]).count();
+            if degree < best_degree {
+                best_degree = degree;
+                best_node = i;
+            }
+        }
+        *selected = best_node;
+        let mut neighbors = [false; N];
+        for i in 0..N {
+            neighbors[i] = !removed[i] && graph[best_node][i];
+        }
+        for i in 0..N {
+            if neighbors[i] {
+                for k in 0..N {
+                    if neighbors[k] && i != k {
+                        graph[i][k] = true;
+                    }
+                }
+            }
+        }
+        removed[best_node] = true;
+    }
+    state.elimination_order = Some(order);
+    Ok(state)
+}
